# ============================================================
# TELEGRAM CREDENTIALS — get from my.telegram.org and @BotFather
# ============================================================
API_ID=your_api_id
API_HASH=your_api_hash
BOT_TOKEN=your_bot_token

# ============================================================
# ADMINS — comma-separated Telegram user IDs
# ============================================================
ADMIN_IDS=123456789,987654321

# ============================================================
# OPTIONAL — sync/log (0 = disabled)
# ============================================================
LOG_GROUP_ID=0
SYNC_CHANNEL_ID=0

# ============================================================
# PERFORMANCE
# ============================================================
MAX_CONCURRENT=50
SEND_DELAY=0.05
MEDIA_GROUP_TIMEOUT=1.0

# ============================================================
# RATE LIMITING
# ============================================================
RATE_LIMIT=30
RATE_WINDOW=20

# ============================================================
# ANTI-DUPLICATE (72h window)
# ============================================================
BLOCK_DUPLICATES=False
DUPLICATE_WINDOW_HOURS=72
DUPLICATE_EXEMPT_ADMINS=False

# ============================================================
# INACTIVITY
# ============================================================
INACTIVITY_HOURS=72
INACTIVITY_CHECK_INTERVAL=3600

# ============================================================
# MAINTENANCE
# ============================================================
RAM_CLEANUP_INTERVAL=300
BACKUP_INTERVAL=86400
REBOOT_INTERVAL=21600

# ============================================================
# FILES
# ============================================================
DB_FILE=data/bot.db
BACKUP_DIR=data/backups

# clean.py: comma-separated user/channel IDs to remove (empty = skip)
# CLEAN_EXCLUDE_IDS=

# ============================================================
# CONTENT PROTECTION — disable forwarding (toggle via /toggleforward)
# ============================================================
PROTECT_CONTENT=true

# ============================================================
# POINTS SYSTEM — toggle via /togglepoints
# ============================================================
POINTS_SYSTEM_ENABLED=false
POINTS_NAME=Points
TAG_NAME=TAG
TAG_THRESHOLD=100
POINTS_MAX=110
FIRE_POINTS=2
DISGUST_POINTS=-1
REACTION_WINDOW_HOURS=24
MEDIA_POINTS=1
DUPLICATE_PENALTY=-2

# ============================================================
# WELCOME / RULES MESSAGE (optional)
# Use \\n for line breaks.
# Example: WELCOME_RULES=Welcome!\\n\\nRules: be respectful.
# ============================================================
# WELCOME_RULES=

# ============================================================
# MULTI-INSTANCE SHARED REGISTRY (optional)
# Required only when running multiple instances of this bot
# that should NOT share users between them.
# Each instance must have a unique BOT_INSTANCE_ID.
# ============================================================
BOT_INSTANCE_ID=bot1
SHARED_REGISTRY_PATH=shared/registry.db
